# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase Dashboard > Project Settings > API
# เว้นว่างทั้งหมดเพื่อใช้โหมดเดโมแบบ localStorage เหมือนเดิม

# --- Frontend (เปิดเผยในเบราว์เซอร์ได้ ใช้ anon/public key เท่านั้น) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend API (ห้ามขึ้นต้นด้วย VITE_ และห้ามเปิดเผย) ---
# service_role key ใช้ใน server/app.ts เท่านั้น: ตั้งใน .env.local สำหรับ dev:api และใน Environment Variables ของ Vercel
SUPABASE_SERVICE_ROLE_KEY=
